{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "types": ["vite/client", "node"],
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@content/*": ["./content/*"],
      "@pipelines/*": ["./pipelines/*"]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "content/**/*.ts",
    "pipelines/**/*.ts",
    "vite.config.ts",
    "vite.workbench.config.ts"
  ],
  "exclude": ["dist", "dist-workbench", "node_modules", "pipelines/video/remotion"]
}
